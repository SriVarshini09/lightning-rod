# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
PHONEUSE_API_KEY=pbk_...
PHONEUSE_DEVICE_ID=            # optional; default is the first phone the key can see
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # pick a voice in ElevenLabs and paste its id
ELEVENLABS_MODEL=eleven_flash_v2_5
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lightning-rod

# Where things run
HUB_URL=https://your-repl.replit.app   # the phone must be able to open this
MIRROR_URL=http://127.0.0.1:8787
HUB_KEY=                               # optional; if set on Replit too, /maya and /control need ?k=<key>

# Tuning (optional)
VISION_MODEL=claude-haiku-5-5          # or claude-opus-5-5 with VISION_FAST=1
VISION_EFFORT=low
TEXT_MODEL=claude-sonnet-5-5
